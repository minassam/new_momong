PORT=3200
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=fit_hair

# JWT (운영 환경에서는 반드시 변경)
JWT_SECRET=change_me_in_production

# CORS (허용할 프론트 origin 콤마로 구분)
ALLOWED_ORIGINS=http://localhost:3202,http://localhost:3203

# 공유 링크에 사용할 사용자 프론트 base URL
FRONTEND_URL=http://localhost:3203

# 환경변수 어드민 (선택) - DB admin_accounts 와 별개로 동작
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# 부팅 시 자동 시드되는 기본 어드민 계정 (DB에 어드민이 0명일 때만 동작)
# 미지정 시 admin@momong.com / admin1234 로 생성 — 운영 환경에서는 반드시 변경
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# Swagger UI Basic Auth (생략 시 admin/admin1234)
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin1234

# 얼굴 분석 (face_landmark) - 로컬 개발 시 localhost, 운영은 AWS EB URL
PYTHON_SERVER_URL=http://localhost:3201

# AWS S3 (얼굴 이미지 업로드 + 분석 결과 저장용)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=momong-staging
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PRESIGNED_EXPIRES_IN=300

# 모몽 OS(직원 앱) 연동 — 상담 저장 · 공유 링크를 만들면 리포트 요약을 OS 고객 기록으로 보낸다.
# 둘 다 있어야 동작(없으면 안 보냄). KEY 는 모몽 OS 시크릿 CONSULT_REPORT_KEY 와 같은 값.
# MOMONG_OS_URL=https://merci-care.<계정>.workers.dev
# MOMONG_OS_KEY=
